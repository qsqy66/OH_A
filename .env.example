# LLM provider (OpenAI-compatible API)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_NAME=glm-5.3-flash
GLM_CHAT_MODEL=glm-5.3-flash
GLM_EMBED_MODEL=embedding-3
GLM_LITE_MODEL=glm-5.3-flash

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=office_agent:
SESSION_TTL=86400

# API
API_KEY=replace-with-a-long-random-key
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100/minute

# Runtime
DOCS_DIR=./docs
VECTOR_PERSIST_DIR=./vector_data
VECTOR_COLLECTION=office_docs
LOG_LEVEL=INFO

# RAG 查询改写：用轻量模型把口语化问题改写成检索式（false 则直接用原问题）
RAG_QUERY_REWRITE=true

# RAG 召回/重排：向量召回 Top-N 候选，再用 Cross-encoder 重排取最终 Top-N
RAG_RECALL_TOP_K=10
RAG_TOP_K=3

# Cross-encoder 重排（Qwen Reranker，未配 Key 时自动回退余弦顺序）
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_ENDPOINT=https://cn-beijing.maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3.7-text-rerank

# External web search (Brave Search API)
SEARCH_API_KEY=replace-with-your-brave-search-key
SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
SEARCH_TIMEOUT=15
SEARCH_MAX_RESULTS=5
