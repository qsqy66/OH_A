# ============================================================================
#  .gitignore — 企业办公自动化智能体
# ============================================================================

# —— Python 编译缓存 ——
__pycache__/
*.py[cod]
*.pyo
*.pyd

# —— 虚拟环境 ——
venv/
venv_win/
.venv_win/
.venv/
env/
.env/

# —— 环境变量（含敏感信息，绝对不要提交） ——
.env
!.env.example

# —— IDE 配置 ——
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# —— 测试 & 覆盖率 ——
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# —— 构建产物 ——
dist/
build/
*.egg-info/
*.egg

# —— 运行时数据 ——
#docs/
chroma_data/
vector_data/
milvus_data/
*.db
*.sqlite3

# —— 日志文件 ——
*.log
logs/

# —— Jupyter ——
.ipynb_checkpoints/

# —— Git ——
*.orig
.gitattributes
